# Canonical site origin. Drives canonicals, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.childresspaintingtx.com

# The project map uses Leaflet with OpenStreetMap tiles and needs no API key.
# If you later prefer Google or Mapbox tiles, add the key here and change the
# single tileLayer URL in components/map/ProjectMapCanvas.tsx.
# NEXT_PUBLIC_MAP_TILE_KEY=
